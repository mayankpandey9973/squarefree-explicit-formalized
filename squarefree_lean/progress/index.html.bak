<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Squarefree Lean — Formalization Status</title>
<style>
  :root {
    --bg: #0e1116;
    --panel: #161b22;
    --panel2: #1c232c;
    --text: #e6edf3;
    --muted: #8b949e;
    --border: #30363d;
    --planned: #6e7681;
    --scaffolded: #58a6ff;
    --error: #f85149;
    --inprogress: #db61a2;
    --partial: #d29922;
    --done: #3fb950;
    --checking: #a371f7;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0; height: 100%;
    background: var(--bg); color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  header {
    padding: 12px 18px; border-bottom: 1px solid var(--border);
    background: var(--panel); position: sticky; top: 0; z-index: 5;
  }
  h1 { font-size: 18px; margin: 0 0 6px 0; }
  h1 .sub { color: var(--muted); font-weight: 400; font-size: 13px; margin-left: 8px; }
  #banner {
    display: none; margin-top: 8px; padding: 8px 12px; border-radius: 6px;
    background: #3a2d00; color: #ffd666; border: 1px solid #6b5400; font-size: 13px;
  }
  #banner.show { display: block; }
  #totals { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .chip {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 3px 9px; border-radius: 14px; font-size: 12px;
    background: var(--panel2); border: 1px solid var(--border);
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .meta { color: var(--muted); font-size: 12px; margin-left: auto; }
  main { display: flex; height: calc(100vh - 110px); }
  #graphwrap { flex: 1; position: relative; overflow: auto; }
  svg { display: block; }
  .layerband { fill: rgba(255,255,255,0.015); }
  .layerlabel { fill: var(--muted); font-size: 13px; font-weight: 600; }
  .edge { stroke: #3d4754; stroke-width: 1.4; fill: none; marker-end: url(#arrow); }
  .edge.hl { stroke: #8b949e; stroke-width: 2.2; }
  .node rect {
    rx: 7; ry: 7; stroke: var(--border); stroke-width: 1.5; cursor: pointer;
  }
  .node text { fill: #0d1117; font-size: 11.5px; font-weight: 600; pointer-events: none; }
  .node .cnt { fill: #0d1117; font-size: 10px; font-weight: 500; opacity: 0.85; }
  .node .badgebg { fill: rgba(13,17,23,0.78); pointer-events: none; }
  .node .badge { fill: #e6edf3; font-size: 9.5px; font-weight: 700; pointer-events: none; }
  .node.planned rect { fill: var(--planned); }
  .node.scaffolded rect { fill: var(--scaffolded); }
  .node.error rect { fill: var(--error); }
  .node.in-progress rect { fill: var(--inprogress); }
  .node.partial rect { fill: var(--partial); }
  .node.done rect { fill: var(--done); }
  .node.checking rect { fill: var(--checking); }
  .node.sel rect { stroke: #fff; stroke-width: 3; }
  #side {
    width: 320px; border-left: 1px solid var(--border); background: var(--panel);
    padding: 16px; overflow-y: auto; font-size: 13px;
  }
  #side h2 { font-size: 15px; margin: 0 0 10px 0; word-break: break-all; }
  #side .row { display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid var(--border); }
  #side .row .k { color: var(--muted); }
  #side .empty { color: var(--muted); }
  #side .statusline { padding: 6px 10px; border-radius: 6px; display: inline-block; color: #0d1117; font-weight: 700; margin-bottom: 12px; }
  code { background: var(--panel2); padding: 1px 5px; border-radius: 4px; font-size: 12px; word-break: break-all; }
  .pillist { margin-top: 6px; }
  .pillist .dep { display:block; color: var(--muted); padding: 2px 0; }
</style>
</head>
<body>
<header>
  <h1>Squarefree Lean — Formalization Status
    <span class="sub" id="genat">loading…</span>
  </h1>
  <div id="banner">⏳ mathlib bootstrap in progress… build status not yet available; showing source-derived status.</div>
  <div id="totals"></div>
</header>
<main>
  <div id="graphwrap">
    <svg id="svg" width="1200" height="800"></svg>
  </div>
  <div id="side">
    <div class="empty">Click a node to see details.</div>
  </div>
</main>

<script>
const SVGNS = "http://www.w3.org/2000/svg";
const LAYER_ORDER = ["L0","L1","L2","L3","L4","L5","L?"];
const STATUS_COLOR = {
  "planned":"#6e7681","scaffolded":"#58a6ff","error":"#f85149",
  "in-progress":"#db61a2","partial":"#d29922","done":"#3fb950","checking":"#a371f7"
};
const LEGEND = [
  ["planned","planned"],["scaffolded","scaffolded"],["in-progress","in-progress"],
  ["partial","partial"],["error","error"],["checking","checking"],["done","done"]
];

let selected = null;
let lastSig = "";

function el(tag, attrs) {
  const e = document.createElementNS(SVGNS, tag);
  for (const k in (attrs||{})) e.setAttribute(k, attrs[k]);
  return e;
}

function shortLabel(mod) {
  // strip leading "Squarefree."
  return mod.replace(/^Squarefree\.?/, "") || "Squarefree (root)";
}

function render(data) {
  // banner
  const banner = document.getElementById("banner");
  banner.className = data.bootstrap_done ? "" : "show";
  document.getElementById("genat").textContent =
    "generated " + new Date(data.generated_at).toLocaleTimeString() +
    (data.bootstrap_done ? (data.build_ran ? " · build OK" : " · build idle") : " · pre-bootstrap");

  // totals
  const totalsEl = document.getElementById("totals");
  totalsEl.innerHTML = "";
  for (const [st] of LEGEND) {
    const n = (data.totals && data.totals[st]) || 0;
    const c = document.createElement("span");
    c.className = "chip";
    c.innerHTML = `<span class="dot" style="background:${STATUS_COLOR[st]}"></span>${st}: <b>${n}</b>`;
    totalsEl.appendChild(c);
  }
  const meta = document.createElement("span");
  meta.className = "meta";
  meta.textContent = `${data.module_count} modules`;
  totalsEl.appendChild(meta);

  drawGraph(data);
}

function drawGraph(data) {
  const svg = document.getElementById("svg");
  while (svg.firstChild) svg.removeChild(svg.firstChild);

  // defs / arrow marker
  const defs = el("defs");
  const marker = el("marker", {id:"arrow", viewBox:"0 0 10 10", refX:"9", refY:"5",
    markerWidth:"7", markerHeight:"7", orient:"auto-start-reverse"});
  marker.appendChild(el("path", {d:"M 0 0 L 10 5 L 0 10 z", fill:"#3d4754"}));
  defs.appendChild(marker);
  svg.appendChild(defs);

  // group by layer
  const byLayer = {};
  for (const m of data.modules) {
    (byLayer[m.layer] = byLayer[m.layer] || []).push(m);
  }
  const layers = LAYER_ORDER.filter(l => byLayer[l] && byLayer[l].length);

  const NODE_W = 168, NODE_H = 46, GAP_X = 24, LAYER_H = 120;
  const LABEL_W = 40, PAD_TOP = 16;
  // sort nodes in each layer by module name for stability
  for (const l of layers) byLayer[l].sort((a,b)=>a.module.localeCompare(b.module));

  // compute width
  let maxCols = 0;
  for (const l of layers) maxCols = Math.max(maxCols, byLayer[l].length);
  const width = LABEL_W + maxCols * (NODE_W + GAP_X) + GAP_X;
  const height = PAD_TOP + layers.length * LAYER_H + 20;
  svg.setAttribute("width", Math.max(width, 900));
  svg.setAttribute("height", Math.max(height, 400));

  // position map: module -> {x,y, cx, cy}
  const pos = {};
  layers.forEach((l, li) => {
    const rowY = PAD_TOP + li * LAYER_H;
    // band + label
    svg.appendChild(el("rect", {class:"layerband", x:0, y:rowY-6,
      width: Math.max(width,900), height: LAYER_H-8}));
    const lab = el("text", {class:"layerlabel", x:8, y:rowY + NODE_H/2 + 4});
    lab.textContent = l;
    svg.appendChild(lab);

    const nodes = byLayer[l];
    const totalW = nodes.length * (NODE_W + GAP_X) - GAP_X;
    let startX = LABEL_W + Math.max(0, (width - LABEL_W - totalW)/2);
    nodes.forEach((m, ci) => {
      const x = startX + ci * (NODE_W + GAP_X);
      const y = rowY;
      pos[m.module] = {x, y, cx: x + NODE_W/2, cy: y + NODE_H/2, w:NODE_W, h:NODE_H};
    });
  });

  // edges first (so nodes draw on top). edge from dep -> module (dependency points up)
  const edgeEls = {};
  for (const m of data.modules) {
    for (const dep of (m.edges||[])) {
      const a = pos[dep], b = pos[m.module];
      if (!a || !b) continue;
      // draw from dep bottom to module top (curve)
      const x1 = a.cx, y1 = a.y + a.h, x2 = b.cx, y2 = b.y;
      const my = (y1 + y2)/2;
      const path = el("path", {class:"edge",
        d:`M ${x1} ${y1} C ${x1} ${my}, ${x2} ${my}, ${x2} ${y2}`});
      svg.appendChild(path);
      (edgeEls[m.module] = edgeEls[m.module]||[]).push(path);
      (edgeEls[dep] = edgeEls[dep]||[]).push(path);
    }
  }

  // nodes
  for (const m of data.modules) {
    const p = pos[m.module]; if (!p) continue;
    const g = el("g", {class:"node " + m.status});
    g.dataset.module = m.module;
    if (selected === m.module) g.classList.add("sel");
    g.appendChild(el("rect", {x:p.x, y:p.y, width:p.w, height:p.h}));
    const t = el("text", {x:p.cx, y:p.y+18, "text-anchor":"middle"});
    t.textContent = trunc(shortLabel(m.module), 24);
    g.appendChild(t);
    // counts line
    const parts = [];
    if (m.sorry_count) parts.push("sorry " + m.sorry_count);
    if (m.stub_count) parts.push("STUB " + m.stub_count);
    if (m.axiom_count) parts.push("ax " + m.axiom_count);
    if (!parts.length) parts.push(m.exists ? m.status : "—");
    const c = el("text", {class:"cnt", x:p.cx, y:p.y+35, "text-anchor":"middle"});
    c.textContent = trunc(parts.join(" · "), 28);
    g.appendChild(c);
    // plan-completeness badge: present/expected (only when a plan exists)
    if (m.expected_count > 0) {
      const txt = `${m.present_count}/${m.expected_count}`;
      const bw = 12 + txt.length * 6;
      const bx = p.x + p.w - bw - 4, by = p.y + 4;
      g.appendChild(el("rect", {class:"badgebg", x:bx, y:by, width:bw, height:14, rx:7, ry:7}));
      const bt = el("text", {class:"badge", x:bx + bw/2, y:by+10.5, "text-anchor":"middle"});
      bt.textContent = txt;
      g.appendChild(bt);
    }
    g.addEventListener("click", () => selectNode(m, edgeEls));
    svg.appendChild(g);
  }

  // re-apply highlight if selected
  if (selected) {
    const m = data.modules.find(x=>x.module===selected);
    if (m) highlightEdges(m, edgeEls);
  }
}

function trunc(s, n){ return s.length>n ? s.slice(0,n-1)+"…" : s; }

function highlightEdges(m, edgeEls) {
  document.querySelectorAll(".edge.hl").forEach(e=>e.classList.remove("hl"));
  (edgeEls[m.module]||[]).forEach(e=>e.classList.add("hl"));
}

function selectNode(m, edgeEls) {
  selected = m.module;
  document.querySelectorAll(".node.sel").forEach(n=>n.classList.remove("sel"));
  const g = document.querySelector(`.node[data-module="${cssEsc(m.module)}"]`);
  if (g) g.classList.add("sel");
  highlightEdges(m, edgeEls);
  showSide(m);
}

function cssEsc(s){ return s.replace(/([.])/g,"\\$1"); }

function showSide(m) {
  const side = document.getElementById("side");
  const col = STATUS_COLOR[m.status] || "#666";
  const rows = [
    ["module", `<code>${m.module}</code>`],
    ["file", `<code>${m.file}</code>`],
    ["layer", m.layer],
    ["exists", m.exists],
    ["build", m.build_status],
    ["theorems/lemmas", m.theorem_count],
    ["defs/structures", m.def_count],
    ["sorry", m.sorry_count],
    ["STUB", m.stub_count],
    ["axiom", m.axiom_count],
    ["last checked", new Date(m.last_checked).toLocaleTimeString()],
  ];
  if ((m.expected_count || 0) > 0) {
    rows.splice(5, 0,
      ["planned deliverables", `<b>${m.present_count}/${m.expected_count}</b> present`]);
  }
  let html = `<div class="statusline" style="background:${col}">${m.status.toUpperCase()}</div>`;
  html += `<h2>${shortLabel(m.module)}</h2>`;
  for (const [k,v] of rows) html += `<div class="row"><span class="k">${k}</span><span>${v}</span></div>`;
  if ((m.expected_count || 0) > 0) {
    const miss = m.missing || [];
    html += `<div class="pillist"><div class="k" style="color:var(--muted);margin-top:10px;">`
          + `missing deliverables (${miss.length}):</div>`;
    if (miss.length) for (const n of miss) html += `<span class="dep">✗ <code>${n}</code></span>`;
    else html += `<span class="dep" style="color:var(--done)">✓ all present</span>`;
    html += `</div>`;
  }
  html += `<div class="pillist"><div class="k" style="color:var(--muted);margin-top:10px;">depends on:</div>`;
  if ((m.edges||[]).length) for (const d of m.edges) html += `<span class="dep">→ ${shortLabel(d)}</span>`;
  else html += `<span class="dep">(none)</span>`;
  html += `</div>`;
  side.innerHTML = html;
}

async function poll() {
  try {
    const r = await fetch("status.json?_=" + Date.now(), {cache:"no-store"});
    if (r.ok) {
      const data = await r.json();
      const sig = JSON.stringify({g:data.generated_at, t:data.totals,
        s:data.modules.map(m=>[m.module,m.status,m.sorry_count,m.stub_count,m.axiom_count,
          m.present_count,m.expected_count])});
      if (sig !== lastSig) { lastSig = sig; render(data); }
    }
  } catch (e) { /* keep last render */ }
}

poll();
setInterval(poll, 5000);
</script>
</body>
</html>
